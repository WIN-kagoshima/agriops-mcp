# react@19 (devDependency, used by the UI dashboard bundle) and the vendored
# @modelcontextprotocol/inspector-client's radix-ui stack (peer react@^18.3.1)
# cannot both be satisfied by npm's strict peer resolver, even though
# package-lock.json already nests a private react@18.3.1 copy under
# inspector-client that makes this work at runtime. `npm ci` re-validates
# peers on every install and fails with ERESOLVE without this flag.
# See: https://github.com/npm/rfcs/blob/main/implemented/0025-install-strategies.md
legacy-peer-deps=true
